  "constraints": [
    {
      "columns": [
        "order_id"
      ],
      "description": "one row per order",
      "id": "C01",
      "type": "unique"
    },
    {
      "description": "item counts are consistent",
      "id": "C02",
      "query": "n_items >= n_distinct_products and n_distinct_products >= 1 and n_sellers >= 1",
      "type": "query"
    },
    {
      "description": "amounts are non-negative",
      "id": "C03",
      "query": "total_price >= 0 and total_freight >= 0 and payment_total >= 0",
      "type": "query"
    },
    {
      "description": "every order has a valid payment",
      "id": "C04",
      "query": "max_installments >= 0 and n_payments >= 1",
      "type": "query"
    },
    {
      "description": "day counts are non-negative",
      "id": "C05",
      "query": "promised_days >= 0 and delivery_days >= 0",
      "type": "query"
    },
    {
      "description": "target definition",
      "id": "C06",
      "query": "is_late == (delivery_days > promised_days)",
      "type": "query"
    },
    {
      "description": "same_state is consistent",
      "id": "C07",
      "query": "same_state == (customer_state == seller_state)",
      "type": "query"
    },
    {
      "description": "delivery happens after purchase",
      "id": "C08",
      "query": "delivered_customer_ts >= purchase_ts",
      "type": "query"
    },
    {
      "description": "review score range",
      "id": "C09",
      "query": "review_score >= 1 and review_score <= 5",
      "type": "query",
      "where_not_null": [
        "review_score"
      ]
    },
    {
      "description": "bad_review consistency",
      "id": "C10",
      "query": "bad_review == (review_score <= 2)",
      "type": "query",
      "where_not_null": [
        "review_score",
        "bad_review"
      ]
    },
    {
      "column": "purchase_ts",
      "description": "purchase window",
      "id": "C11",
      "max_exclusive": "2018-09-01 00:00:00",
      "min": "2017-01-01 00:00:00",
      "type": "date_range"
    }
  ],
  "contract_version": "1.0",
  "dataset": {
    "currency": "BRL",
    "grain": "one row per delivered order",
    "license": "MIT (GitHub repository); Kaggle listing CC BY-NC-SA 4.0. Attribute Olist; non-commercial coursework.",
    "name": "olist_delivered_orders_clean",
    "snapshot_date": "2018-10-17",
    "source": "Olist Brazilian E-Commerce Public Dataset (GitHub olist/work-at-olist-data)"
  },
  "date_range": {
    "column": "purchase_ts",
    "max": "2018-08-29 15:00:37",
    "min": "2017-01-05 11:56:06"
  },
  "feature_rules": {
    "allowed_sources": "only columns with available_at == 'checkout'",
    "identifiers_excluded": [
      "order_id",
      "customer_unique_id",
      "primary_product_id",
      "primary_seller_id",
      "customer_zip_prefix",
      "seller_zip_prefix"
    ],
    "leakage_rule": "a feature may only be derived from information known at purchase time"
  },
  "forbidden_features": [
    "approved_ts",
    "delivered_carrier_ts",
    "delivered_customer_ts",
    "delivery_days",
    "review_score",
    "bad_review",
    "is_late"
  ],
  "known_limitations": {
    "items": [
      "Delivered-only population understates delivery failure: 3.0% of all orders never reached 'delivered'.",
      "Right-censoring: the snapshot ends 2018-10-17; August 2018 is a censored buffer excluded from evaluation.",
      "The late rate is non-stationary (1.2% in 2018-06 vs 19.0% in 2018-03).",
      "Single marketplace, 2017-2018 data: patterns may not transfer to today."
    ],
    "narrative_source": "template"
  },
  "population": {
    "excluded": "non-delivered orders, delivered orders without a delivery date, orders without items or a valid payment, orders delivered before purchase",
    "order_status": "delivered",
    "purchase_window": [
      "2017-01-01",
      "2018-08-31"
    ]
  },
  "primary_key": [
    "order_id"
  ],
  "privacy": {
    "dropped": [
      "customer_city",
      "seller_city",
      "review text"
    ],
    "kept": [
      "customer_unique_id",
      "customer_zip_prefix",
      "seller_zip_prefix"
    ],
    "note": "Identifiers are Olist's public pseudonymous hashes; zip prefix plus timestamps are quasi-identifiers, so dashboards show aggregates only."
  },
