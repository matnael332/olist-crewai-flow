{
  "name": "pulse",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "settings": {},
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "charliermarsh.ruff"]
    }
  },
  "updateContentCommand": "pipx install uv && uv sync --locked --all-groups",
  "portsAttributes": {
    "8501": { "label": "Dashboard", "onAutoForward": "notify" },
    "8000": { "label": "API", "onAutoForward": "notify" }
  },
  "forwardPorts": [8501, 8000]
}
