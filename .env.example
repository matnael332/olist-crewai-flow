# Copy to .env and fill in. Never commit .env.

# The dataset spec the pipeline runs on, as pkg.module:ATTR (or pass --spec on the command line).
# Example (the test spec): PIPELINE_DATASET_SPEC=tests.toy_spec:SPEC
PIPELINE_DATASET_SPEC=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# "llm" or "deterministic". Empty means llm when GEMINI_API_KEY is set, otherwise deterministic.
PIPELINE_MODE=

# Runtime flags. The packages also set these at import time; PYTHONHASHSEED and PYTHONUTF8
# only take effect when set in the parent shell before Python starts.
PYTHONHASHSEED=0
PYTHONUTF8=1
OMP_NUM_THREADS=2
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
CREWAI_TRACING_ENABLED=false

# Optional: where the dashboard and the API read artifacts from (default: ./artifacts)
ARTIFACTS_DIR=
